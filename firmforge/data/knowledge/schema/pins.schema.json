{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/schema/pins.schema.json",
  "title": "FirmForge Board Pin Map",
  "description": "板级引脚映射的合约。注意：pins.json 的上游与 registers.json **不同** —— 寄存器来自芯片厂商（datasheet / io*.h），引脚来自 ArduinoCore-avr 的 variants/。同一份「知识库」跨了两个上游，所以分区与生成都要按上游分别对待（标准 §5.3）。",
  "type": "object",
  "required": ["board", "mcu", "mcu_series", "version", "pins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "生成器应写 'knowledge/schema/pins.schema.json'。"
    },
    "$id": {
      "type": "string"
    },
    "board": {
      "type": "string",
      "minLength": 1,
      "description": "board_id，须与 firmforge/data/boards/<board_id>/ 目录名一致。"
    },
    "mcu": {
      "type": "string",
      "minLength": 1
    },
    "mcu_series": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "total_digital_pins": {
      "type": "integer",
      "minimum": 0
    },
    "total_analog_pins": {
      "type": "integer",
      "minimum": 0
    },
    "led_builtin": {
      "$ref": "#/$defs/pin"
    },
    "serial_ports": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/serial_port"
      }
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "baud_rate_presets": {
      "type": "object",
      "description": "key 为波特率字符串（如 '115200'），便于 S2 置信度评分直接查表。",
      "additionalProperties": {
        "$ref": "#/$defs/baud_preset"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": ["arduino_pin", "port", "bit"],
      "description": "未声明 additionalProperties:false —— 数据里存在 '$ref' 键（数据手册章节引用），而 '$ref' 是 JSON Schema 的保留关键字，显式声明该属性名有被实现误读的风险。允许额外属性即可容纳它。",
      "properties": {
        "arduino_pin": {
          "type": "integer",
          "minimum": 0,
          "description": "Arduino 逻辑引脚号（用户代码里写的那个数字）。"
        },
        "port": {
          "type": "string",
          "pattern": "^[A-Z]$",
          "description": "AVR 端口字母（A–L）。"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "register": {
          "type": "string"
        },
        "ddr": {
          "type": "string"
        },
        "pin_reg": {
          "type": "string"
        },
        "special": {
          "type": "string",
          "description": "复用功能标注（如 'RXD0/USART0 RX'），S2 引脚冲突检查的依据。"
        }
      }
    },
    "serial_port": {
      "type": "object",
      "required": ["rx_arduino_pin", "tx_arduino_pin"],
      "properties": {
        "rx_arduino_pin": {
          "type": "integer",
          "minimum": 0
        },
        "tx_arduino_pin": {
          "type": "integer",
          "minimum": 0
        },
        "rx_port": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "rx_bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "tx_port": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "tx_bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "usart": {
          "type": "string"
        }
      }
    },
    "baud_preset": {
      "type": "object",
      "required": ["ubrr"],
      "properties": {
        "ubrr": {
          "type": "integer",
          "minimum": 0
        },
        "ubrr_hex": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{1,4}$"
        },
        "f_cpu": {
          "type": "string",
          "description": "**字符串**形式（如 '16000000UL'），保留 C 字面量的 UL 后缀。"
        },
        "error_pct": {
          "type": "number",
          "description": "相对误差百分比，可正可负。S2 置信度评分的输入。"
        }
      }
    }
  }
}
